{
  "_": "Разбор записи номера. Проверяется вызовом normalize(input): должно получиться окно из 8 цифр либо null. null означает «движок честно не понял» — это правильное поведение, а не сбой. Именно на этом наборе падал старый npm run test:engine.",
  "engineVersion": "3.1",
  "cases": [
    {
      "input": "09l 11 11 01",
      "expectWindow": "91111101",
      "why": "строчная латинская l читается как единица"
    },
    {
      "input": "09L 11 11 01",
      "expectWindow": null,
      "why": "заглавная L на единицу не похожа — номер не распознаётся"
    },
    {
      "input": "O.3.3.3.3.3.4.Б.Б",
      "expectWindow": "33333466",
      "why": "заглавная Б как шестёрка"
    },
    {
      "input": "O.3.3.3.3.3.4.б.б",
      "expectWindow": "33333466",
      "why": "строчная б"
    },
    {
      "input": "0ЧЧ 12 34 56",
      "expectWindow": "44123456",
      "why": "заглавная Ч как четвёрка"
    },
    {
      "input": "0чч 12 34 56",
      "expectWindow": "44123456",
      "why": "строчная ч"
    },
    {
      "input": "Օ.9.6.З.З.З.З.4.8",
      "expectWindow": "96333348",
      "why": "армянская заглавная Օ и кириллическая З"
    },
    {
      "input": "օ.9.6.з.з.з.з.4.8",
      "expectWindow": "96333348",
      "why": "те же буквы строчными"
    },
    {
      "input": "О99 ООО74О",
      "expectWindow": "99000740",
      "why": "кириллическая О вместо нулей"
    },
    {
      "input": "+374 91 11 11 01",
      "expectWindow": "91111101",
      "why": "международный формат"
    },
    {
      "input": "00374 77 77 77 97",
      "expectWindow": "77777797",
      "why": "международный формат через 00"
    },
    {
      "input": "Ucom 044.666066",
      "expectWindow": "44666066",
      "why": "название оператора перед номером"
    },
    {
      "input": "091 47 82 63 Team VIP",
      "expectWindow": "91478263",
      "why": "текст после номера"
    },
    {
      "input": "033.22.00.71 ՆՈՐ 043.22.00.71",
      "expectWindow": null,
      "why": "два разных номера в строке"
    },
    {
      "input": "095-666-949.041-666-949",
      "expectWindow": null,
      "why": "то же самое без пробелов"
    },
    {
      "input": "033 3X XX XX",
      "expectWindow": null,
      "why": "маска вместо цифр"
    },
    {
      "input": "",
      "expectWindow": null,
      "why": "пустой ввод"
    },
    {
      "input": "abc",
      "expectWindow": null,
      "why": "вообще не номер"
    }
  ]
}